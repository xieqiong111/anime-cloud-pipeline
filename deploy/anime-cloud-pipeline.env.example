# Stable deployment paths. Copy this file to config/anime-cloud-pipeline.env.
ANIME_PIPELINE_CONFIG=<config-path>
ANIME_PIPELINE_STATE_DIR=<state-directory>
ANIME_PIPELINE_LOG_DIR=<log-directory>
ANIME_PIPELINE_LOCK_PATH=<state-directory>/run.lock

# Credential values and the writable 115 destination ID stay in this private file.
MOVIEPILOT_TOKEN=
P115_COOKIE=
P115_ROOT_DIRECTORY_ID=
LITEPAN_API_KEY=
EMBY_API_KEY=
