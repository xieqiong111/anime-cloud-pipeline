{
  "schema_version": 5,
  "services": {
    "moviepilot": {
      "name": "moviepilot",
      "base_url": "http://127.0.0.1:3000",
      "token_env": "MOVIEPILOT_TOKEN",
      "auth_mode": "x-api-key",
      "media_source": "tmdb",
      "subscription_sources": [
        "Bangumi订阅",
        "admin"
      ]
    },
    "cloud": {
      "name": "p115",
      "credential_env": "P115_COOKIE",
      "root_directory_path": "/<cloud-root>"
    },
    "litepan": {
      "name": "litepan",
      "base_url": "http://127.0.0.1:5211",
      "api_key_env": "LITEPAN_API_KEY",
      "task_name": "追番"
    },
    "emby": {
      "name": "emby",
      "base_url": "http://emby.example:8097",
      "api_key_env": "EMBY_API_KEY",
      "library_name": "<emby-library-name>"
    }
  },
  "source": {
    "name": "kisssub",
    "kind": "kisssub",
    "base_url": "https://www.kisssub.org"
  },
  "paths": {
    "cloud_source_root": "/<cloud-root>/<quarter-label>/未整理",
    "cloud_library_root": "/<cloud-root>",
    "litepan_output_root": "/<litepan-strm-root>",
    "moviepilot_mount_root": "/<moviepilot-mount-root>",
    "emby_mount_root": "/<litepan-strm-root>",
    "state_directory": "/<state-directory>",
    "litepan_raw_output_root": "/<litepan-raw-root>",
    "cloud_library_subdir": "整理"
  },
  "scoring": {
    "include_weight": 10,
    "language_weight": 5,
    "release_group_weight": 3,
    "resolution_weight": 2,
    "collection_penalty": 4
  },
  "limits": {
    "network_timeout_seconds": 30,
    "max_read_retries": 3,
    "max_task_pages": 20,
    "max_recursive_depth": 8,
    "max_recursive_files": 1000,
    "max_new_tasks_per_run": 5,
    "max_new_tasks_per_subscription": 5,
    "max_review_batch": 5,
    "max_reconcile_batch": 5,
    "max_cloud_checks_per_run": 8
  },
  "retry": {
    "max_attempts": 3,
    "backoff_seconds": 1,
    "backoff_max_seconds": 30,
    "jitter_seconds": 0.25
  },
  "runtime": {
    "litepan_task_name": "<litepan-task-name>",
    "emby_library_name": "<emby-library-name>",
    "reconcile_batch": 5,
    "litepan_task_source_root": "/<cloud-root>/<quarter-label>",
    "litepan_task_output_root": "/<litepan-raw-root>/<quarter-label>",
    "litepan_task_db_path": "/<litepan-host-data>/litepan.db",
    "litepan_strm_host_root": "/<litepan-host-strm-root>",
    "litepan_event_name": "<litepan-event-name>",
    "litepan_event_source": "<litepan-event-source>",
    "emby_library_root": "/<litepan-strm-root>/<quarter-label>"
  },
  "schedule": {
    "timezone": "Asia/Shanghai",
    "cron": "0 4 * * *"
  }
}
